{
    "name": "obsidian-sync-folds",
    "version": "1.0.0",
    "description": "Enables Syncing of Fold States Across Devices",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "author": {
        "name": "James Alexandre",
        "url": "https://github.com/itsonlyjames"
    },
    "keywords": [
        "obsidian",
        "obsidian-plugin",
        "fold",
        "sync",
        "collapse"
    ],
    "license": "MIT",
    "overrides": {
        "minimatch": "^9.0.7",
        "flatted": "^3.4.2",
        "brace-expansion": "^2.0.3",
        "picomatch": "^4.0.4",
        "yaml": "^2.8.3"
    },
    "devDependencies": {
        "@types/node": "^16.11.6",
        "@typescript-eslint/eslint-plugin": "^8.53.1",
        "@typescript-eslint/parser": "^8.53.1",
        "@typescript-eslint/utils": "^8.53.1",
        "esbuild": "^0.25.0",
        "eslint": "^9.39.2",
        "eslint-plugin-obsidianmd": "^0.1.9",
        "globals": "^17.6.0",
        "obsidian": "latest",
        "tslib": "2.4.0",
        "typescript": "^5.9.3"
    }
}
